# ==============================================================================
# VM 5: Challenge Execution Host & Proxmox Orchestrator (192.168.200.15)
# ==============================================================================
PORT=5050
VM5_HOST_IP=192.168.200.15
TRAEFIK_DASHBOARD_PORT=8080
DOCKER_API_PORT=2375
CTF_DOMAIN=ctf.local
TRAEFIK_NETWORK=traefik_net

# Proxmox VE API Configuration
# Point to Proxmox VE Cluster API (e.g. Node pms1 or pms2)
PROXMOX_API_URL=https://192.168.200.12:8006/api2/json
PROXMOX_DEFAULT_NODE=pms1
PROXMOX_DEFAULT_STORAGE=local-lvm
PROXMOX_DEFAULT_BRIDGE=vmbr0

# Authentication (Option A: API Token - Recommended)
PROXMOX_TOKEN_ID=root@pam!ctf
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Authentication (Option B: User/Password ticket fallback)
PROXMOX_USERNAME=root@pam
PROXMOX_PASSWORD=
